{
  "name": "vue3-dev-template",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "description": "A `quick-start` Vue3 Template",
  "author": "Hubery Yang",
  "license": "MIT",
  "homepage": "https://github.com/Hub-yang/my-vue-dev-template#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hub-yang/my-vue-dev-template.git"
  },
  "bugs": {
    "url": "https://github.com/Hub-yang/my-vue-dev-template/issues"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "vue-tsc --noEmit && vite build",
    "tscheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "taze": "npx taze major -r",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^14.1.0",
    "prismjs": "^1.30.0",
    "sass": "^1.97.1",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@iconify-json/carbon": "^1.2.15",
    "@iconify-json/ep": "^1.2.3",
    "@types/node": "^25.0.3",
    "@types/prismjs": "^1.26.5",
    "@unocss/eslint-plugin": "^66.5.12",
    "@unocss/reset": "^66.5.12",
    "@vitejs/plugin-vue": "^6.0.3",
    "element-plus": "^2.13.0",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "unocss": "^66.5.12",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^30.0.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.1"
  },
  "lint-staged": {
    "*": "eslint . --fix"
  }
}
